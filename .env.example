# Port exposed on the Unraid host
UNRAID_APP_PORT=2442

# Required local UI password (minimum 12 characters).
# Use a unique random value; changing it invalidates every active session.
LOCAL_AUTH_PASSWORD=replace-with-a-long-random-password

# Unraid's default nobody:users identity
PUID=99
PGID=100

# Persistent encrypted configuration and audit log
APPDATA_PATH=/mnt/user/appdata/unraid-control

# Optional 32-byte key encoded as base64 or 64 hex characters.
# Leave empty to generate and persist a private key in APPDATA_PATH.
ARRAY_ENCRYPTION_KEY=

# Maximum SFTP upload size in bytes (default: 2 GiB).
MAX_UPLOAD_BYTES=2147483648

# Set true only when running behind a trusted reverse proxy.
TRUST_PROXY=false

# Optional GraphQL schema URL override. Empty uses the matching official Unraid API tag.
UNRAID_SCHEMA_URL=
TZ=UTC
